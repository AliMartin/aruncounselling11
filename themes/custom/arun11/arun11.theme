<?php

/**
 * @file
 * Arun Counselling 11 theme file.
 */


/**
 * Implements hook_preprocess_html().
 */
function arun11_preprocess_html(array &$variables): void {
  // Add a body class based on the node background colour field.
  $route_node = \Drupal::routeMatch()->getParameter('node');

  if ($route_node instanceof \Drupal\node\NodeInterface
    && $route_node->hasField('field_background_colour')
    && !$route_node->get('field_background_colour')->isEmpty()
  ) {
    $bg = (string) $route_node->get('field_background_colour')->value;
    if ($bg !== '') {
      $variables['attributes']['class'][] = 'background-' . \Drupal\Component\Utility\Html::getClass($bg);
    }
  }
}
